{
    source: {
        directories: [
            "src"
        ],
        excludes: [
            // Generated Unicode tables are verified by functional tests instead.
            "NamePrep/CaseFoldingData.php",
            "NamePrep/NamePrepData2003.php",
            "NamePrep/NamePrepData2008.php"
        ]
    },
    timeout: 10,
    threads: "max",
    testFramework: "phpunit",
    phpUnit: {
        configDir: ".",
        customPath: "vendor/bin/phpunit"
    },
    mutators: {
        "@default": true
    }
}
